{
  "class": {
    "prefix": "class",
    "body": ["class ${1:ClassName} {", "\tconstructor(${2}) {", "\t\t$0", "\t}", "}"],
    "description": "Basic class"
  },
  "interface": {
    "prefix": "interface",
    "body": ["interface ${1:InterfaceName} {", "\t${2:propertyName}: ${3:type};", "\t${4:methodName}(${5}): ${6:void};", "\t$0", "}"],
    "description": "Interface declaration"
  },
  "decoratorclass": {
    "prefix": "decoratorclass",
    "body": [
      "function ${1:decoratorName}(target: any, context: ClassDecoratorContext) {",
      "\t${2:// modify or wrap the class here}",
      "\treturn target;",
      "}",
      "$0"
    ],
    "description": "Stage-3 class decorator function"
  },
  "singleton": {
    "prefix": "singleton",
    "body": [
      "class ${1:ClassName} {",
      "\tprivate static instance: ${1:ClassName};",
      "",
      "\tprivate constructor(${2}) {",
      "\t\t$0",
      "\t}",
      "",
      "\tstatic getInstance(${2}): ${1:ClassName} {",
      "\t\tif (!${1:ClassName}.instance) {",
      "\t\t\t${1:ClassName}.instance = new ${1:ClassName}(${3});",
      "\t\t}",
      "\t\treturn ${1:ClassName}.instance;",
      "\t}",
      "}"
    ],
    "description": "Singleton with a private constructor"
  },
  "factory": {
    "prefix": "factory",
    "body": [
      "class ${1:Product}Factory {",
      "\tstatic create(kind: string): ${1:Product} {",
      "\t\tswitch (kind) {",
      "\t\t\tcase '${2:variant}':",
      "\t\t\t\treturn new ${3:ConcreteProduct}();",
      "\t\t\tdefault:",
      "\t\t\t\tthrow new Error(`Unknown kind: ${kind}`);",
      "\t\t}",
      "\t}",
      "}"
    ],
    "description": "Static factory method"
  },
  "observer": {
    "prefix": "observer",
    "body": [
      "interface ${1:Observer} {",
      "\tupdate(${2:data}: ${3:unknown}): void;",
      "}",
      "",
      "class ${4:Subject} {",
      "\tprivate observers: ${1:Observer}[] = [];",
      "",
      "\tsubscribe(observer: ${1:Observer}): void {",
      "\t\tthis.observers.push(observer);",
      "\t}",
      "",
      "\tnotify(${2:data}: ${3:unknown}): void {",
      "\t\tthis.observers.forEach((observer) => observer.update(${2:data}));",
      "\t}",
      "}"
    ],
    "description": "Observer interface + subject"
  },
  "strategy": {
    "prefix": "strategy",
    "body": [
      "interface ${1:Strategy} {",
      "\texecute(${2:data}: ${3:unknown}): ${4:unknown};",
      "}",
      "",
      "class ${5:Context} {",
      "\tconstructor(private strategy: ${1:Strategy}) {}",
      "",
      "\trun(${2:data}: ${3:unknown}): ${4:unknown} {",
      "\t\treturn this.strategy.execute(${2:data});",
      "\t}",
      "}"
    ],
    "description": "Strategy interface + context"
  },
  "decorator": {
    "prefix": "decorator",
    "body": [
      "function ${1:decoratorName}<T extends (...args: any[]) => any>(fn: T): T {",
      "\treturn function (this: unknown, ...args: Parameters<T>) {",
      "\t\t${2:// before}",
      "\t\tconst result = fn.apply(this, args);",
      "\t\t${3:// after}",
      "\t\treturn result;",
      "\t} as T;",
      "}",
      "$0"
    ],
    "description": "Higher-order function decorator, generic over the wrapped function's type"
  }
}
